# Copy to .env for local development. Never commit real secrets.
# The server's npm scripts load <repo>/.env when it exists; variables already set in the
# environment win. docker compose reads the same file for the ${...} values below.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://centinela:centinela@localhost:5432/centinela

# Bearer token for POST /api/ingest. Use a long random value outside development
# (for example: openssl rand -hex 32). Production refuses the default and anything
# shorter than 32 characters.
INGEST_TOKEN=dev-ingest-token-change-me

# Relative paths are resolved against the repository root.
RULES_DIR=./rules
CONTENT_DIR=./content

# Express "trust proxy": false, true, a hop count (1) or addresses/subnets ("loopback").
# Set it only when a reverse proxy you control sits in front of the server. Rate limits,
# the sign-in lockout and the audit log use the client IP it yields.
TRUST_PROXY=false

# Dashboard sign-in (single admin). Left empty outside production, the development sign-in
# is used: user "admin", password "centinela-dev". Production refuses to start without
# ADMIN_USERNAME, ADMIN_PASSWORD_HASH and SESSION_SECRET, or with the development values.
# Create the hash with `npm run hash-password --silent` and paste the printed line; keep the
# single quotes, the hash contains "$" characters.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Keys session ids and CSRF tokens (at least 32 characters in production, for example
# openssl rand -hex 32). Changing it signs everyone out.
SESSION_SECRET=

# Sessions end after this many minutes without requests, and after SESSION_MAX_HOURS.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12
# Failed sign-ins from one client IP before a temporary lockout, and its length.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Requests per minute per client IP.
RATE_LIMIT_INGEST_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=30

# Web: set to true to run the dashboard against MSW mocks instead of the API.
VITE_USE_MOCKS=false
# Web dev server: where Vite proxies /api (default http://localhost:3000).
API_PROXY_TARGET=http://localhost:3000

# docker compose: host ports (bound to 127.0.0.1).
POSTGRES_PORT=5432
SERVER_PORT=3000
WEB_PORT=8080
