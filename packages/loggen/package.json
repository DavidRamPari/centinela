{
  "name": "@centinela/loggen",
  "version": "0.1.0",
  "private": true,
  "description": "Seeded demo log generator with ground truth for Centinela.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@centinela/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "centinela-loggen": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "loggen": "tsx --conditions=@centinela/source src/cli.ts"
  },
  "dependencies": {
    "@centinela/shared": "^0.1.0"
  }
}
