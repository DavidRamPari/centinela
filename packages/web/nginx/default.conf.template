# Rendered by the nginx image's envsubst step (API_UPSTREAM) at container start.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Uploads through the dashboard are limited to 5 MB by the API; leave headroom.
    client_max_body_size 6m;

    # The API sets its own security headers (helmet, strict CSP, no-store).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Server-Sent Events (/api/stream) must not be buffered.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        include /etc/nginx/snippets/centinela-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html (every dashboard route) and the other files of the build.
    location / {
        include /etc/nginx/snippets/centinela-security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
