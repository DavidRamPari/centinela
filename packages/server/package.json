{
  "name": "@centinela/server",
  "version": "0.1.0",
  "private": true,
  "description": "Centinela API server, ingestion pipeline and detection engine.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=@centinela/source src/index.ts | pino-pretty",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=@centinela/source src/db/cli/migrate.ts",
    "hash-password": "tsx --conditions=@centinela/source src/auth/cli/hash-password.ts",
    "ingest": "tsx --conditions=@centinela/source src/ingest/cli.ts",
    "rules:report": "tsx --conditions=@centinela/source src/detection/cli/report.ts",
    "bench": "tsx --conditions=@centinela/source src/detection/cli/bench.ts",
    "content:validate": "tsx --conditions=@centinela/source src/content/cli/validate.ts"
  },
  "dependencies": {
    "@centinela/shared": "^0.1.0",
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "re2-wasm": "^1.0.2",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@centinela/loggen": "^0.1.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
}
