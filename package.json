{
  "name": "centinela",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight, open-source SIEM: Sigma detection, correlation and a bilingual dashboard.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web",
    "packages/loggen"
  ],
  "scripts": {
    "dev": "concurrently --names server,web --prefix-colors blue,magenta \"npm run dev -w packages/server\" \"npm run dev -w packages/web\"",
    "build": "npm run build -w packages/shared && npm run build -w packages/server -w packages/web -w packages/loggen",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w packages/server --",
    "ingest": "npm run ingest -w packages/server --",
    "loggen": "npm run loggen -w packages/loggen --",
    "rules:report": "npm run rules:report -w packages/server --",
    "bench": "npm run bench -w packages/server --",
    "demo": "tsx --conditions=@centinela/source scripts/demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
